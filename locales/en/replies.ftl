# Replies to slash commands and buttons, and what Marian's actions report.
reply-outside = Use Marian inside a server.
reply-event-outside = Use /event inside a server.
reply-button-outside = Use that button inside a server.
reply-gone = That isn't here any more.
reply-event-missing = That event isn't here.
reply-open-path = Open { $path }.
reply-dm-sent = I sent you a DM. Answer there and I'll post the event.
reply-dm-not-sent = I couldn't send the DM.
reply-dm-not-opened = I couldn't open a DM.
reply-dm-allow = Allow direct messages from server members, then run /event again.
reply-dm-web-at = You can always create the event at { $url }.
reply-dm-web = You can always create the event on the web.
reply-help = /event starts an event. Marian asks in a DM where to post it, the title, the description, when it starts, when it ends, and how often it repeats.
reply-help-more-page = The other commands are explained on the Help page.
reply-help-more-at = The other commands are explained at { $url }.
reply-sort-where = Run /sort inside an event channel. It reverses the order of the posts there.
reply-sorted = Reversed the posts in #{ $channel }.
reply-event-updated = Updated { $title }. Open { $path }.
reply-reminders-get = { $name } gets reminders.
reply-reminders-opted-out = { $name } is opted out of reminders.
reply-channel-kind-event = event
reply-channel-kind-text = text
reply-setting-updated = Updated { $key }.
reply-library-empty = The option library is empty.
reply-library-kept = { $emoji } { $name } is in the library.
reply-library-saved = Saved { $emoji } { $name } in the library.
reply-library-removed = Removed { $name } from the library.
reply-presets-empty = No presets yet.
reply-preset-saved = Saved the { $name } preset.
reply-preset-removed = Removed { $name }.
reply-google-click = Click the button below to connect Google Calendar.
reply-google-button = Sign in with Google
reply-google-auto-on = Marian will keep your Google Calendar updated.
reply-google-auto-off = Automatic Google Calendar updates are paused. /google sync still adds one event.
reply-google-already-off = Google Calendar is already disconnected.
reply-google-revoking = Google Calendar will be disconnected, and Marian will remove the events it added.
reply-google-sync = Marian will add { $title } to your Google Calendar.
notice-reminders-on = Reminders are on for { $name }.
notice-reminders-off = { $name } won't be pinged for reminders.
notice-channel-created = Created #{ $name }.
notice-signed-up = { $name } signed up as { $option }.
notice-moved = { $name } moved to { $option }.
notice-waiting = { $name } is waiting for a { $option } spot.
notice-left = { $name } left { $option }.
notice-left-waitlist = { $name } left the { $option } waitlist.
notice-added = Added { $name } to { $option }.
notice-removed = Removed { $name } from { $option }.
notice-already-on = { $name } is already on { $option }.
notice-was-not-on = { $name } wasn't on { $option }.
notice-deleted = Deleted { $title }.
notice-cancelled = Cancelled { $title }.
