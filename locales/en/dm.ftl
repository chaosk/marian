# The questions Marian asks in a DM after /event.
dm-cancelled = Cancelled. Run /event in the server when you want to try again.
dm-exit = To exit, type 'cancel'
dm-pick-number = Enter a number to select an option
dm-where-title = Where would you like to post this event?
dm-where-here = In the current channel, { $channel }
dm-where-other = In another channel
dm-title-title = Enter the event title
dm-title-body = Up to 120 characters are permitted
dm-description-title = Enter the event description
dm-description-body = Type `none` for no description. Up to 2000 characters are permitted.
dm-start-title = When should the event start?
dm-start-body =
    Your time zone is: **{ $zone }**
    Type `timezone` to change it.

    > Friday at 9pm
    > Tomorrow at 18:00
    > Now
    > In 1 hour
    > 2026-10-14 19:00
dm-zone-title = Which time zone?
dm-time-unreadable = Marian couldn't read that time.
dm-end-title = When does the event end?
dm-end-body =
    Type `none` for a 1 hour event.

    > 2 hours
    > 9pm
    > Friday at 6am
dm-end-unreadable = Try "2 hours", "9pm", "Friday at 6am", or `none` for 1 hour.
dm-repeat-title = How often should this event repeat?
dm-repeat-never = Never
dm-repeat-daily = Daily
dm-repeat-weekly = Weekly
dm-repeat-biweekly = Every two weeks
dm-repeat-monthly = Monthly
dm-finish-title = Finish or customize
dm-finish-types = Signup options: { $names }.
dm-finish-multiple = People can pick more than one option.
dm-finish-plain = Don't need anything fancy?
dm-finish-done = Finish event creation
dm-finish-or = Or change something first:
dm-finish-signup = Signup options
dm-finish-mention = Mention roles when the event is posted
dm-finish-image = Add an image
dm-finish-color = Change the event color
dm-finish-restrict = Restrict signup to certain roles
dm-finish-multiple-toggle = Allow multiple responses
dm-finish-role = Assign a role to attendees
dm-finish-cutoff = Set a time when signups close
dm-finish-post = Schedule when the event is posted
dm-finish-reminders = Configure reminders
dm-signup-title = Signup options
dm-signup-defaults = Keep the defaults (Accepted, Declined, Tentative)
dm-signup-custom-title = Configure signup options
dm-signup-custom-body = Send the option names, separated by commas.
dm-signup-preset = Use a signup option preset
dm-no-presets = There are no signup presets yet.
dm-mention-hint = Send the numbers, separated by commas. `everyone` mentions @everyone. `none` clears mentions.
dm-restrict-hint = Send the numbers, separated by commas, or `none` to clear the limit.
dm-role-hint = Send a number, or `none` for no role.
dm-no-roles = This server has no roles yet.
dm-send-numbers = Send the numbers, separated by commas.
dm-pick-from-list = Send a number from the list.
dm-not-in-list = That number isn't in the list.
dm-image-title = Add an image
dm-image-body = Send an http:// or https:// link, or `none` to clear it.
dm-color-title = Change the event color
dm-cutoff-title = Set a time when signups close
dm-cutoff-body = For example, "tomorrow at 3pm", or `none` to leave signups open.
dm-post-title = Schedule when the event is posted
dm-post-body = For example, "tomorrow at 9am", or `none` to post it now.
dm-reminder-title = Configure reminders
dm-reminder-body = How many minutes before the start should Marian remind people? From 1 to 10080.
dm-created-title = Event has been created!
dm-view-event = [Click here to view the event]({ $url })
dm-next-title = What would you like to do?
dm-next-modify = Modify the event
dm-next-clear = Remove responses
dm-next-respond = Add a response
dm-next-duplicate = Duplicate the event
dm-open-event = [Open the event]({ $url })
dm-cleared = Removed the responses.
dm-duplicated = Duplicated it. The copy is event { $id }, one week later.
color-marian-blue = Marian blue
color-tide-green = Tide green
color-brass = Brass
color-plum = Plum
color-seal-red = Seal red
color-ink = Ink
